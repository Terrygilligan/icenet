datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PackageStatus {
  PENDING_PICKUP
  IN_TRANSIT_LOCAL
  DEPOT_INVENTORY
  IN_TRANSIT_LINEHAUL
  DELIVERED
}

enum TempClass {
  DEEP_FREEZE
  CHILLED
  AMBIENT
}

enum VehicleType {
  EV_VAN_LOCAL
  EV_TRUCK_HEAVY
  ELECTRIC_RAIL
}

enum TransitMode {
  EV_ROAD
  ELECTRIC_RAIL
}

model Order {
  id                   String     @id @default(uuid())
  clientId             String
  pickupAddress        String
  deliveryAddress      String
  pickupWindowStart    DateTime
  pickupWindowEnd      DateTime
  deliveryWindowStart  DateTime
  deliveryWindowEnd    DateTime
  minTemp              Float
  maxTemp              Float
  status               String     @default("PENDING")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  packages             Package[]

  @@map("orders")
}

model Package {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  barcode        String        @unique
  status         PackageStatus @default(PENDING_PICKUP)
  tempClass      TempClass     @default(CHILLED)
  currentDepotId String?
  currentDepot   Depot?        @relation(fields: [currentDepotId], references: [id])
  currentRouteId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("packages")
}

model Depot {
  id                String     @id @default(uuid())
  name              String
  location          String
  coldStorageType   String     // e.g. "DEEP_FREEZE_-20C", "CHILLED_+2C"
  solarCapacityKW   Float      @default(150.0)
  batteryStorageKWh Float      @default(300.0)
  chargingBaysCount Int        @default(8)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  packages          Package[]
  originLegs        RouteLeg[] @relation("OriginDepot")
  destinationLegs   RouteLeg[] @relation("DestinationDepot")

  @@map("depots")
}

model Vehicle {
  id                 String      @id @default(uuid())
  vin                String      @unique
  type               VehicleType @default(EV_VAN_LOCAL)
  batteryCapacityKWh Float       @default(100.0)
  currentSoCPercent  Float       @default(100.0)
  reeferDrawKW       Float       @default(5.0)
  maxRangeKm         Float       @default(250.0)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("vehicles")
}

model RouteLeg {
  id                   String      @id @default(uuid())
  originDepotId        String
  originDepot          Depot       @relation("OriginDepot", fields: [originDepotId], references: [id])
  destinationDepotId   String
  destinationDepot     Depot       @relation("DestinationDepot", fields: [destinationDepotId], references: [id])
  mode                 TransitMode @default(EV_ROAD)
  distanceKm           Float
  estTransitMinutes    Int         @default(120)
  chargingStopRequired Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@map("route_legs")
}

model EventLog {
  id              String   @id @default(uuid())
  idempotencyKey  String   @unique
  eventType       String
  payload         Json
  deviceId        String?
  processedAt     DateTime @default(now())

  @@map("event_logs")
}
